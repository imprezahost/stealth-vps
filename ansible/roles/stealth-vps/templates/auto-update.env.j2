# {{ ansible_managed }}
# Env vars consumed by /usr/local/bin/python3 -m stealth_vps.auto_update,
# loaded via EnvironmentFile= in stealth-vps-auto-update.service.

# Policy: patch-only | minor-patch | disabled.
# patch-only is the safe default — only roll forward within the same
# MAJOR.MINOR. Major releases require explicit `s-vps update <tag>`.
STEALTH_VPS_AUTO_UPDATE_POLICY={{ stealth_vps_auto_update_policy }}

{% if stealth_vps_auto_update_github_token %}
# Operator-supplied GitHub token. Raises the GitHub API rate limit from
# 60/hr (per IP) to 5000/hr (per token). Set this on fleets behind a
# shared egress IP. Plain PAT or fine-grained token both work.
STEALTH_VPS_GITHUB_TOKEN={{ stealth_vps_auto_update_github_token }}
{% else %}
# No GitHub token configured. Set `stealth_vps_auto_update_github_token`
# in inventory if you fleet >50 hosts behind one IP and start hitting
# the 60/hr unauthenticated rate limit.
{% endif %}
