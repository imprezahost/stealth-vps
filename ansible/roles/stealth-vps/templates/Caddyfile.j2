# /etc/caddy/Caddyfile — stealth-vps subscription endpoint + protocol fronting.
#
# Rendered by tasks/subscription.yml. Two site shapes:
#
#   expose=false (default)  →  loopback on 127.0.0.1:8443 with the
#                              packaged self-signed Caddy cert. Operator
#                              fetches the subscription via SSH tunnel.
#
#   expose=true             →  bind :443, Let's Encrypt + the configured
#                              domain. Requires stealth_vps_domain.
#
# v0.11.0+: when XHTTP / VMess+WS are enabled, the public-TLS site adds
# reverse_proxy handles that forward the CDN-fronted path to the
# loopback Xray inbound. These REQUIRE the public site — i.e.
# stealth_vps_subscription_expose=true + a domain. They make no sense
# behind the loopback-only :8443 site (clients connect from the
# internet), so they're rendered only in the expose=true branch.
#
# Everything not explicitly handled gets a 404 so the host doesn't
# accidentally become a generic web server.

{
    # Disable the admin API endpoint — we don't need it and it widens
    # the attack surface unnecessarily.
    admin off
    # Auto-HTTPS on uses ACME; off forces HTTP-only or manual TLS.
    # Decided per-site below; the global default doesn't matter.
}

{% if stealth_vps_subscription_expose %}
# --- Public, TLS-terminated site ---------------------------------------
# `{$STEALTH_VPS_BOT_PUBLIC_HOST}` would also work, but we render the
# concrete domain into the file so `caddy validate` can resolve it.
{{ stealth_vps_domain }} {
    # ACME auto-issuance via Let's Encrypt. acme.sh's certs are not
    # reused — Caddy maintains its own.
    tls {{ stealth_vps_tls_email | default("admin@" + stealth_vps_domain, true) }}

    # Subscription files. `handle_path` strips the prefix; the remaining
    # path segment is the token, rewritten to <token>.txt.
    handle_path {{ stealth_vps_subscription_path }}/* {
        root * /var/lib/stealth-vps/subscriptions
        rewrite * {path}.txt
        file_server {
            hide .* *.tmp
        }
    }
{% if stealth_vps_xhttp_enabled | default(false) | bool and stealth_vps_xhttp_state is defined %}

    # v0.11.0+ — XHTTP reverse-proxy. `handle` (not handle_path) so the
    # full path reaches Xray, which matches on xhttpSettings.path. The
    # loopback Xray inbound speaks plain HTTP; Caddy terminated TLS.
    handle {{ stealth_vps_xhttp_state.path }}* {
        reverse_proxy 127.0.0.1:{{ stealth_vps_xhttp_state.port }}
    }
{% endif %}
{% if stealth_vps_vmess_ws_enabled | default(false) | bool and stealth_vps_vmess_ws_state is defined %}

    # v0.11.0+ — VMess+WebSocket reverse-proxy. Caddy auto-handles the
    # WS Upgrade handshake; reverse_proxy forwards to the loopback Xray
    # ws inbound. Exact-path match (no trailing wildcard) — the WS
    # endpoint is a single path, not a prefix tree.
    handle {{ stealth_vps_vmess_ws_state.path }} {
        reverse_proxy 127.0.0.1:{{ stealth_vps_vmess_ws_state.port }}
    }
{% endif %}

    # Fall-through: anything else gets a 404, no directory listing.
    respond 404
}

{% else %}
# --- Loopback-only subscription endpoint -------------------------------
# 127.0.0.1:8443 — operator fetches via SSH tunnel:
#   ssh -L 8443:127.0.0.1:8443 root@vps
#   curl http://127.0.0.1:8443{{ stealth_vps_subscription_path }}/<token>
#
# XHTTP / VMess+WS fronting is NOT rendered here — those need a public
# TLS site (set stealth_vps_subscription_expose=true + a domain).
:8443 {
    # Bind to loopback only — Caddy resolves `:8443` to 0.0.0.0 by
    # default, so we use `bind` to constrain it.
    bind 127.0.0.1

    handle_path {{ stealth_vps_subscription_path }}/* {
        root * /var/lib/stealth-vps/subscriptions
        rewrite * {path}.txt
        file_server {
            hide .* *.tmp
        }
    }

    respond 404
}
{% endif %}
