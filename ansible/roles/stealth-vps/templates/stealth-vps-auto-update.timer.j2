# {{ ansible_managed }}
# Daily firing of stealth-vps-auto-update.service. Calendar-driven so
# multiple hosts in a fleet roll forward in a known window — easier to
# correlate with downstream monitoring.

[Unit]
Description=stealth-vps auto-update — daily fire

[Timer]
# Default `*-*-* 04:23:00` = every day at 04:23 UTC. Different minute
# from the sub-prune timer (03:17) so the two units never compete for
# disk/CPU on the same wakeup.
OnCalendar={{ stealth_vps_auto_update_oncalendar }}
# Wider jitter than the prune timer (default 1 hour) so a fleet of N
# hosts behind one egress IP doesn't burst-hit GitHub's API.
RandomizedDelaySec={{ stealth_vps_auto_update_randomized_delay }}
Persistent=true
Unit=stealth-vps-auto-update.service

[Install]
WantedBy=timers.target
